# Local development can use the Vite proxy; this explicit URL also works.
# Production should point to the deployed FastAPI service.
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=false
# Optional local-only access token. Leave empty in production.
VITE_DEMO_TOKEN=
VITE_DEV_LOGIN_IDENTIFIER=
VITE_DEV_LOGIN_PASSWORD=
